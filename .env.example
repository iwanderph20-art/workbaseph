# ─────────────────────────────────────────────────────────────────────────────
# WorkBase PH — Environment Variables
# Copy this file to .env for local development.
# Set all variables in Railway dashboard for production.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://workbaseph.com                  # Production domain (used in payment redirect URLs)
NODE_ENV=production

# ── Security (CRITICAL — change both before going live) ──────────────────────
JWT_SECRET=replace-with-long-random-string      # Min 32 chars. Used to sign all auth tokens.
ADMIN_PASSWORD=replace-with-strong-password     # WorkBase admin panel password
ADMIN_EMAIL=admin@workbaseph.com                # Admin panel login email

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname   # Railway provides this automatically

# ── PayPal (Payment Gateway) ──────────────────────────────────────────────────
# Get these from: https://developer.paypal.com → My Apps & Credentials
PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx          # Required — safe to expose client-side
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx      # Required — server-side only, never expose
PAYPAL_WEBHOOK_ID=xxxxxxxxxxxxxxxxxxxx         # Required — from PayPal webhook settings
PAYPAL_MODE=live                               # Set to "sandbox" for testing

# Webhook setup:
#   URL:    https://workbaseph.com/api/payments/webhook
#   Events: PAYMENT.CAPTURE.COMPLETED
#   Copy the Webhook ID → PAYPAL_WEBHOOK_ID

# ── PayPal Amounts (USD — optional overrides) ─────────────────────────────────
# Defaults are set in routes/payments.js. Override here if needed.
# PP_AMOUNT_PAY_PER_POST=18.00
# PP_AMOUNT_ESSENTIAL=49.00
# PP_AMOUNT_ESSENTIAL_ANNUAL=490.00
# PP_AMOUNT_PRO=79.00
# PP_AMOUNT_PRO_ANNUAL=790.00
# PP_AMOUNT_AI_AUDIT=15.00
# PP_AMOUNT_FEATURED=15.00

# ── Email — Resend ────────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
# Without this, emails log to console instead of sending (non-blocking).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── File Uploads ──────────────────────────────────────────────────────────────
# Set if using cloud storage for resumes/documents. Local disk used if not set.
# UPLOAD_PATH=/uploads

# ── AI Services (optional) ────────────────────────────────────────────────────
# Required only if AI Candidate Audit feature is active
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
